<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.caseapp.location.mapper.AppLocationMapper">

    <resultMap type="com.ruoyi.project.caseapp.location.domain.AppLocation" id="AppLocationResult">
        <id     property="locationId"    column="location_id"    />
        <result property="locationCode"  column="location_code"  />
        <result property="locationName"  column="location_name"  />
        <result property="areaName"      column="area_name"      />
        <result property="remark"        column="remark"         />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectAppLocationVo">
        select location_id, location_code, location_name, area_name, remark, create_time
        from app_location
    </sql>

    <select id="selectAppLocationList" parameterType="com.ruoyi.project.caseapp.location.domain.AppLocation" resultMap="AppLocationResult">
        <include refid="selectAppLocationVo"/>
        <where>
            <if test="locationCode != null and locationCode != ''"> and location_code = #{locationCode}</if>
            <if test="locationName != null and locationName != ''"> and location_name like concat('%', #{locationName}, '%')</if>
            <if test="areaName != null and areaName != ''"> and area_name = #{areaName}</if>
        </where>
        order by area_name, location_code
    </select>

    <select id="selectByLocationCode" parameterType="String" resultMap="AppLocationResult">
        <include refid="selectAppLocationVo"/>
        where location_code = #{locationCode}
    </select>

    <select id="selectByLocationId" parameterType="Long" resultMap="AppLocationResult">
        <include refid="selectAppLocationVo"/>
        where location_id = #{locationId}
    </select>

</mapper>
